# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=mock-dev-secret-key-replace-me-with-50-random-characters-0000
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=medtrain
DB_USER=postgres
DB_PASSWORD=mock-db-password
DB_HOST=localhost
DB_PORT=5432

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── OAuth2 (optional — leave empty to disable social login) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=
OAUTH_SUCCESS_REDIRECT_URL=/api/auth/oauth/token/

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── File storage ──────────────────────────────────────────────────────────────
STORAGE_BACKEND=minio

# MinIO (dev / self-hosted)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=mock-minio-user
MINIO_SECRET_KEY=mock-minio-password
MINIO_BUCKET=medtrain
MINIO_PUBLIC_URL=http://localhost:9000

# AWS S3 (prod only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# ── AI / MLflow ───────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_ACCURACY_THRESHOLD=0.80

# ── Email (prod only) ─────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── CORS (prod only) ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=
