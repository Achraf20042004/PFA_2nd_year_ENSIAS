[flake8]
max-line-length = 119
exclude =
    venv,
    .venv,
    .git,
    __pycache__,
    backend/apps/*/migrations,
    backend/config/settings/test.py,
    backend/config/settings/ci.py,
    docs,
    frontend,
    mobile,
# Allow long import lines and common Django patterns
extend-ignore =
    # line too long — handled by max-line-length
    E501,
    # whitespace before ':'
    E203,
    # do not use bare 'except'  — we intentionally use it in badge failure isolation
    E722,
per-file-ignores =
    # F401: imported but unused — needed in __init__ and settings wildcard imports
    backend/config/settings/*.py:F401,F403
